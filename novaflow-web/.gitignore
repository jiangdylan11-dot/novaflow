# Dependencies and build output live per-package; none of it belongs in git.
node_modules/
web/dist/
worker/dist/
worker/data/
# Cloudflare's own release binary, 52 MB. tools/fetch-cloudflared.mjs gets it.
worker/vendor/
.artifacts/
*.log

# Local environment
.env
.env.local
.env.*.local

# Worker runtime state
identity.json
worker.config.json

# Build output of the renderer transform
web-dist/
worker-renderer/
compute-renderer/
worker/dist-compute/
# ffmpeg.wasm's 32 MB core, GPL. tools/fetch-ffmpeg-core.mjs gets it; the build calls that.
renderer/vendor/ffmpeg/core/
# 视频抠图 in the browser: ONNX Runtime Web (tools/fetch-onnxruntime-web.mjs, the build calls it) and the
# BiRefNet_lite ONNX export (tools/export-browser-matting-model.py, run once on the build machine).
renderer/vendor/onnxruntime-web/
renderer/vendor/matting/
