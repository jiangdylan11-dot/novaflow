NOVAFLOW_ADMIN_SERVER_ENV=production
NOVAFLOW_ADMIN_SERVER_HOST=127.0.0.1
NOVAFLOW_ADMIN_SERVER_PORT=4761
NOVAFLOW_ADMIN_SERVER_CORS_ORIGINS=https://app.example.com
NOVAFLOW_ADMIN_SERVER_REQUEST_LOGS=1
NOVAFLOW_ADMIN_SERVER_ENABLE_DEV_LOGIN=0

NOVAFLOW_ADMIN_API_TOKEN=replace-with-long-random-admin-token
NOVAFLOW_SESSION_SECRET=replace-with-at-least-32-random-characters
NOVAFLOW_SESSION_TTL_SECONDS=86400

NOVAFLOW_SUPABASE_URL=https://your-project.supabase.co
NOVAFLOW_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NOVAFLOW_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key

NOVAFLOW_COMFYUI_BASE_URL=https://cloud.comfy.org
NOVAFLOW_COMFYUI_API_KEY=replace-with-backend-only-comfyui-api-key
NOVAFLOW_COMFYUI_API_KEY_SECRET_REF=comfyui/api-key

NOVAFLOW_GROK_BASE_URL=https://api.x.ai/v1
NOVAFLOW_GROK_MODEL=grok-4.3
NOVAFLOW_GROK_API_KEY=replace-with-backend-only-grok-api-key

# RunningHub domestic provider: configuration/account checks only in this phase.
# Never copy these secrets to the public site or worker distribution.
NOVAFLOW_RUNNINGHUB_BASE_URL=https://www.runninghub.cn
NOVAFLOW_RUNNINGHUB_API_KEY=
NOVAFLOW_RUNNINGHUB_LLM_BASE_URL=https://llm.runninghub.cn/v1
NOVAFLOW_RUNNINGHUB_LLM_MODEL=
NOVAFLOW_RUNNINGHUB_GPT_IMAGE_ENDPOINT=
NOVAFLOW_RUNNINGHUB_GOOGLE_IMAGE_ENDPOINT=

# Supabase Edge Function deployment notes:
# - Cloud function name: novaflow-backend
# - Cloud endpoint: https://cjakoblszlmbmotchzva.supabase.co/functions/v1/novaflow-backend
# - Required Edge Function secrets:
#   NOVAFLOW_SESSION_SECRET
#   NOVAFLOW_GROK_BASE_URL
#   NOVAFLOW_GROK_MODEL
#   NOVAFLOW_GROK_API_KEY
# - Supabase injects project secrets such as:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS
#   SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEYS
# - Never expose Service Role or Provider API keys to the NovaFlow renderer/client.
