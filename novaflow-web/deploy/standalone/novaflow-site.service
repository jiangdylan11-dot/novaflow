[Unit]
Description=NovaFlow website and authenticated asset gateway
After=network.target

[Service]
Type=simple
User=novaflow
Group=novaflow
WorkingDirectory=/opt/novaflow-site
EnvironmentFile=/etc/novaflow-site.env
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/novaflow-site/deploy/standalone/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
