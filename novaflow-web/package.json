{
  "name": "novaflow-web-workspace",
  "private": true,
  "version": "2.0.122",
  "type": "module",
  "description": "NovaFlow Web independent workspace: browser editor, local assistant, administration and GPU workers.",
  "workspaces": [
    "packages/shared",
    "control-local",
    "web",
    "worker"
  ],
  "scripts": {
    "control:dev": "node control-local/src/server.mjs",
    "start": "node tools/start-local-stack.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:preview": "npm --prefix web run preview",
    "worker:dev": "npm --prefix worker run dev",
    "worker:headless": "node worker/src/main-headless.mjs",
    "assistant:start": "node worker/src/main-local.mjs",
    "worker:build": "node tools/build-web-renderer.mjs --minify && node tools/fetch-cloudflared.mjs && npm --prefix worker run build:win",
    "test": "node tests/run-tests.mjs",
    "test:sql": "node tests/e2e/sql-contract.test.mjs",
    "test:protocol": "node tests/e2e/protocol.test.mjs",
    "test:control": "node tests/e2e/control-plane.test.mjs",
    "test:security": "node tests/e2e/security.test.mjs",
    "test:multiworker": "node tests/e2e/multi-worker.test.mjs",
    "test:e2e": "node tests/e2e/full-pipeline.test.mjs",
    "verify:stable": "npm run verify:independent",
    "sync:edge": "node tools/sync-edge-function.mjs",
    "check:edge": "node tools/sync-edge-function.mjs --check",
    "test:redaction": "node tests/e2e/workflow-redaction.test.mjs",
    "build:renderer": "node tools/build-web-renderer.mjs",
    "serve:renderer": "python tools/serve-web-dist.py --port 4892 --root web-dist",
    "test:build": "node tests/e2e/web-renderer-build.test.mjs",
    "bundle:edge": "node tools/bundle-edge-function.mjs",
    "config:web": "node tools/set-web-config.mjs",
    "verify:edge": "node tools/verify-edge-bundle.mjs",
    "package:site": "node tools/package-site.mjs",
    "verify:tunnel": "node tools/verify-tunnel.mjs",
    "fetch:cloudflared": "node tools/fetch-cloudflared.mjs",
    "verify:independent": "node tools/check-independent-workspace.mjs",
    "admin:start": "npm --prefix admin start",
    "admin:build": "npm --prefix admin run build:win"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "deno": "^2.9.6",
    "terser": "^5.51.2"
  }
}
