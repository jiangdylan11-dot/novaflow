{
  "appId": "com.novaflow.worker",
  "productName": "NovaFlow",
  "executableName": "NovaFlow",
  "copyright": "NovaFlow",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "src/**/*",
    "workflows/**/*",
    "package.json",
    "!**/*.map",
    "!data/**/*"
  ],
  "extraResources": [
    { "from": "src/matting", "to": "matting", "filter": ["*.py"] },
    { "from": "../web-dist", "to": "web-dist", "filter": ["**/*", "!vendor/onnxruntime-web/**", "!vendor/matting/**"] },
    {
      "from": "../../particle-editor-desktop",
      "to": "desktop-license",
      "filter": [
        "license-core.js",
        "license-public-key.b64",
        "license/**/*.js",
        "main/birefnet-runner.py",
        "prompt-assistant-service.py",
        "prompt_assistant/*.py",
        "prompt_assistant/*.json"
      ]
    },
    {
      "from": "../packages/shared/src",
      "to": "packages/shared/src",
      "filter": [
        "**/*.mjs"
      ]
    },
    {
      "from": "../worker-renderer",
      "to": "worker-renderer",
      "filter": [
        "**/*.js"
      ]
    },
    {
      "from": "vendor",
      "to": "vendor",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../particle-editor-desktop/main/qwen-lora-catalog.js",
      "to": "lora-catalogs/qwen-lora-catalog.cjs"
    },
    {
      "from": "../../particle-editor-desktop/main/minimax-h3-lora-catalog.js",
      "to": "lora-catalogs/minimax-h3-lora-catalog.cjs"
    }
  ],
  "protocols": [{ "name": "NovaFlow 本地仓库", "schemes": ["novaflow"] }],
  "fileAssociations": [{ "ext": "nfproj", "name": "NovaFlow 工程", "description": "NovaFlow 工程（骨骼动画）" }],
  "asar": false,
  "win": {
    "icon": "electron/assets/favicon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "NovaFlowSetup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NovaFlow",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": [
      "zh_CN",
      "en_US"
    ],
    "language": 2052
  },
  "compression": "normal",
  "npmRebuild": false,
  "buildDependenciesFromSource": false
}
