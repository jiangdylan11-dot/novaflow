{
  "appId": "com.novaflow.worker",
  "productName": "Foart",
  "executableName": "Foart",
  "copyright": "Foart",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "src/**/*",
    "workflows/**/*",
    "package.json",
    "!**/*.map",
    "!data/**/*"
  ],
  "extraResources": [
    {
      "from": "src/matting",
      "to": "matting",
      "filter": [
        "*.py"
      ]
    },
    {
      "from": "../web-dist",
      "to": "web-dist",
      "filter": [
        "**/*",
        "!vendor/onnxruntime-web/**",
        "!vendor/matting/**"
      ]
    },
    {
      "from": "../../particle-editor-desktop",
      "to": "desktop-license",
      "filter": [
        "license-core.js",
        "license-public-key.b64",
        "license/**/*.js",
        "main/birefnet-runner.py",
        "prompt-assistant-service.py",
        "prompt_assistant/*.py",
        "prompt_assistant/*.json",
        "prompt_assistant/ui_catalog/**/*.py",
        "prompt_assistant/ui_catalog/**/*.json",
        "prompt_assistant/ui_native/**/*.py",
        "prompt_assistant/ui_native/**/*.json"
      ]
    },
    {
      "from": "../packages/shared/src",
      "to": "packages/shared/src",
      "filter": [
        "**/*.mjs"
      ]
    },
    {
      "from": "../worker-renderer",
      "to": "worker-renderer",
      "filter": [
        "**/*.js"
      ]
    },
    {
      "from": "vendor",
      "to": "vendor",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../particle-editor-desktop/main/qwen-lora-catalog.js",
      "to": "lora-catalogs/qwen-lora-catalog.cjs"
    },
    {
      "from": "../../particle-editor-desktop/main/minimax-h3-lora-catalog.js",
      "to": "lora-catalogs/minimax-h3-lora-catalog.cjs"
    }
  ],
  "protocols": [
    {
      "name": "Foart 本地仓库",
      "schemes": [
        "novaflow"
      ]
    }
  ],
  "fileAssociations": [
    {
      "ext": "nfproj",
      "name": "Foart 工程",
      "description": "Foart 工程（骨骼动画）",
      "icon": "electron/assets/foart-brush.ico"
    }
  ],
  "asar": false,
  "win": {
    "icon": "electron/assets/foart-brush.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "FoartSetup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Foart",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": [
      "zh_CN",
      "en_US"
    ],
    "language": 2052,
    "installerIcon": "electron/assets/foart-brush.ico",
    "uninstallerIcon": "electron/assets/foart-brush.ico",
    "installerHeaderIcon": "electron/assets/foart-brush.ico"
  },
  "compression": "normal",
  "npmRebuild": false,
  "buildDependenciesFromSource": false
}
