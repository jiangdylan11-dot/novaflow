{
  "appId": "com.novaflow.worker",
  "productName": "NovaFlow",
  "executableName": "NovaFlow",
  "copyright": "NovaFlow",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "src/**/*",
    "workflows/**/*",
    "package.json",
    "!**/*.map",
    "!data/**/*"
  ],
  "extraResources": [
    { "from": "../web-dist", "to": "web-dist", "filter": ["**/*"] },
    { "from": "../../particle-editor-desktop", "to": "desktop-license", "filter": ["license-core.js", "license-public-key.b64", "license/**/*.js"] },
    {
      "from": "../packages/shared/src",
      "to": "packages/shared/src",
      "filter": [
        "**/*.mjs"
      ]
    },
    {
      "from": "../worker-renderer",
      "to": "worker-renderer",
      "filter": [
        "**/*.js"
      ]
    },
    {
      "from": "vendor",
      "to": "vendor",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../../particle-editor-desktop/main/qwen-lora-catalog.js",
      "to": "lora-catalogs/qwen-lora-catalog.cjs"
    },
    {
      "from": "../../particle-editor-desktop/main/minimax-h3-lora-catalog.js",
      "to": "lora-catalogs/minimax-h3-lora-catalog.cjs"
    }
  ],
  "asar": false,
  "win": {
    "icon": "electron/assets/favicon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "NovaFlowSetup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NovaFlow",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": [
      "zh_CN",
      "en_US"
    ],
    "language": 2052
  },
  "compression": "normal",
  "npmRebuild": false,
  "buildDependenciesFromSource": false
}
