{
  "name": "novaflow-worker",
  "productName": "NovaFlow Worker",
  "private": true,
  "version": "0.4.0",
  "description": "NovaFlow GPU compute node - runs NovaFlow AI tasks on your own graphics card.",
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "headless": "node src/main-headless.mjs",
    "build:win": "electron-builder --win nsis --x64",
    "build:win:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "32.2.0",
    "electron-builder": "25.1.8"
  }
}
