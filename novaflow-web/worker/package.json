{
  "name": "novaflow-worker",
  "productName": "Foart 算力助手",
  "private": true,
  "version": "2.0.194",
  "description": "Foart 官网算力助手",
  "type": "commonjs",
  "main": "electron/compute-main.cjs",
  "scripts": {
    "dev": "electron electron/compute-main.cjs",
    "dev:compute": "electron electron/compute-main.cjs",
    "headless": "node src/main-compute.mjs",
    "build:win": "electron-builder --config electron-builder-compute.json --win nsis --x64 --publish never",
    "build:win:dir": "electron-builder --config electron-builder-compute.json --win dir --x64"
  },
  "devDependencies": {
    "electron": "32.2.0",
    "electron-builder": "25.1.8"
  },
  "computeOnly": true
}
