      "_meta": {
        "title": "positive"
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "8",
          0
        ]
      },
      "_meta": {
        "title": "negative"
      }
    },
    "4": {
      "class_type": "EmptyLatentAudio",
      "inputs": {
        "seconds": 40,
        "batch_size": 1
      },
      "_meta": {
        "title": "canvas"
      }
