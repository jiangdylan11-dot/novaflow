    "generate_seconds": {
      "node": "4",
      "input": "seconds"
    },
    "seed": {
      "node": "5",
      "input": "seed"
    },
    "loop": {
      "node": "7",
      "input": "enabled"
    },
    "duration_seconds": {
      "node": "7",
      "input": "loop_seconds"
    },
    "crossfade_ms": {
      "node": "7",
      "input": "crossfade_ms"
    },
    "bpm": {
      "node": "7",
      "input": "bpm"
    },
    "prompt": {
      "node": "13",
      "input": "value"
    },
