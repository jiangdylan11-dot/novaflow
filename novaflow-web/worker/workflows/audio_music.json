        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "4",
          0
        ]
      },
      "_meta": {
        "title": "sampler"
      }
    },
    "6": {
      "class_type": "VAEDecodeAudio",
      "inputs": {
        "samples": [
          "5",
          0
        ],
        "vae": [
          "1",
          2
        ]
      },
      "_meta": {
        "title": "decode"
      }
    },
    "7": {
      "class_type": "NovaFlowAudioSeamlessLoop",
      "inputs": {
        "audio": [
          "6",
          0
