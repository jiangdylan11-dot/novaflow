{
  "id": "h3_i2v",
  "comfy": "video",
  "note": "MiniMax H3 image-to-video. The graph mirrors the shape the stable NovaFlow Desktop H3 pipeline builds (UNETLoader -> MiniMaxH3ImageToVideo -> SamplerCustomAdvanced -> CreateVideo -> SaveVideo) and runs on the H3 runtime at 127.0.0.1:8189. Node names were read from that runtime's /object_info, not guessed.",
  "bindings": {
    "prompt": { "node": "5", "input": "prompt" },
    "width": { "node": "5", "input": "width" },
    "height": { "node": "5", "input": "height" },
    "length": { "node": "5", "input": "length" },
    "seed": { "node": "8", "input": "noise_seed" },
    "fps": { "node": "13", "input": "fps" }
  },
  "references": [
    { "index": 0, "node": "20", "input": "image", "filename": "first-frame.png" }
  ],
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "Minimax_H3\\10Eros_Max_h3_TURBO-hybrid_beta5_int8.safetensors", "weight_dtype": "default" },
      "_meta": { "title": "MiniMax H3 UNet" }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" },
      "_meta": { "title": "MiniMax H3 text encoder" }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" },
      "_meta": { "title": "MiniMax H3 video VAE" }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
      "_meta": { "title": "MiniMax H3 audio VAE" }
    },
    "20": {
      "class_type": "LoadImage",
      "inputs": { "image": "first-frame.png" },
      "_meta": { "title": "first_frame" }
    },
    "5": {
      "class_type": "MiniMaxH3ImageToVideo",
      "inputs": {
        "clip": ["2", 0],
        "vae": ["3", 0],
        "prompt": "",
        "width": 480,
        "height": 864,
        "length": 124,
        "first_frame": ["20", 0]
      },
      "_meta": { "title": "MiniMaxH3ImageToVideo" }
    },
    "6": {
      "class_type": "BasicScheduler",
      "inputs": { "scheduler": "simple", "steps": 8, "denoise": 1, "model": ["1", 0] },
      "_meta": { "title": "MiniMax H3 scheduler" }
    },
    "7": {
      "class_type": "KSamplerSelect",
      "inputs": { "sampler_name": "res_multistep" },
      "_meta": { "title": "MiniMax H3 sampler" }
    },
    "8": {
      "class_type": "RandomNoise",
      "inputs": { "noise_seed": 0 },
      "_meta": { "title": "MiniMax H3 seed" }
    },
    "9": {
      "class_type": "BasicGuider",
      "inputs": { "model": ["1", 0], "conditioning": ["5", 0] },
      "_meta": { "title": "MiniMax H3 guider" }
    },
    "10": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": { "noise": ["8", 0], "guider": ["9", 0], "sampler": ["7", 0], "sigmas": ["6", 0], "latent_image": ["5", 1] },
      "_meta": { "title": "MiniMax H3 sampling" }
    },
    "11": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["10", 0], "vae": ["3", 0] },
      "_meta": { "title": "Decode MiniMax H3 video" }
    },
    "12": {
      "class_type": "VAEDecodeAudio",
      "inputs": { "samples": ["10", 0], "vae": ["4", 0] },
      "_meta": { "title": "Decode MiniMax H3 audio" }
    },
    "13": {
      "class_type": "CreateVideo",
      "inputs": { "images": ["11", 0], "audio": ["12", 0], "fps": 24, "bit_depth": 8 },
      "_meta": { "title": "Create MiniMax H3 video" }
    },
    "14": {
      "class_type": "SaveVideo",
      "inputs": { "video": ["13", 0], "filename_prefix": "novaflow_web/H3", "format": "auto", "codec": "auto" },
      "_meta": { "title": "Save MiniMax H3 video" }
    }
  }
}
