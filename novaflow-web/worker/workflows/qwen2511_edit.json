{
  "id": "qwen2511_edit",
  "comfy": "image",
  "note": "Reference-driven edit on Qwen Image Edit 2511. The first uploaded reference lands in ComfyUI's input folder as reference-1.png before the graph is queued.",
  "bindings": {
    "prompt": { "node": "2", "input": "text" },
    "negative_prompt": { "node": "3", "input": "text" },
    "width": { "node": "8", "input": "width" },
    "height": { "node": "8", "input": "height" },
    "steps": { "node": "5", "input": "steps" },
    "cfg": { "node": "5", "input": "cfg" },
    "seed": { "node": "5", "input": "seed" }
  },
  "references": [
    { "index": 0, "node": "7", "input": "image", "filename": "reference-1.png" }
  ],
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "Qwen-Rapid-AIO-NSFW-v20.safetensors" },
      "_meta": { "title": "Qwen AIO checkpoint" }
    },
    "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] }, "_meta": { "title": "positive" } },
    "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] }, "_meta": { "title": "negative" } },
    "7": { "class_type": "LoadImage", "inputs": { "image": "reference-1.png" }, "_meta": { "title": "reference" } },
    "8": {
      "class_type": "ImageScale",
      "inputs": { "image": ["7", 0], "width": 1024, "height": 1024, "upscale_method": "lanczos", "crop": "disabled" },
      "_meta": { "title": "fit reference" }
    },
    "9": { "class_type": "VAEEncode", "inputs": { "pixels": ["8", 0], "vae": ["1", 2] }, "_meta": { "title": "encode" } },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 8,
        "cfg": 1.2,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.7,
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["9", 0]
      },
      "_meta": { "title": "sampler" }
    },
    "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] }, "_meta": { "title": "decode" } },
    "10": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "novaflow_web_edit", "images": ["6", 0] },
      "_meta": { "title": "save" }
    }
  }
}
