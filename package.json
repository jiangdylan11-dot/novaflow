{
  "name": "novaflow-workspace",
  "private": true,
  "scripts": {
    "dev": "python tools/preview_runtime_server.py --host 127.0.0.1 --port 4783 --root particle-editor-desktop/dist/win-unpacked/resources/app/renderer --base-url http://127.0.0.1:8188",
    "dev:runtime": "python tools/preview_runtime_server.py --host 127.0.0.1 --port 4783 --root particle-editor-desktop/dist/win-unpacked/resources/app/renderer --base-url http://127.0.0.1:8188",
    "dev:source": "node -e \"console.error('Locked entry: source preview is retired. Use http://127.0.0.1:4783/.'); process.exit(1)\"",
    "build": "npm run build:renderer",
    "build:renderer": "npm --prefix particle-editor-desktop run build:renderer",
    "sync:runtime": "node scripts/sync-runtime.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --group unit,vitest",
    "test:contracts": "node scripts/run-tests.mjs --group contracts",
    "test:py": "node scripts/run-tests.mjs --group py",
    "test:live": "node scripts/run-tests.mjs --group live",
    "test:update-baseline": "node scripts/run-tests.mjs --update",
    "check:runtime": "node scripts/check-runtime-sync.mjs",
    "dev:desktop": "npm --prefix particle-editor-desktop run dev",
    "check:entry": "python tools/check_4783_runtime.py",
    "check:write-budget": "node scripts/check-runtime-write-budget.mjs",
    "check:write-budget:update": "node scripts/check-runtime-write-budget.mjs --update",
    "check:split-removal": "node scripts/check-split-removal-result-contract.mjs",
    "check:ai-seq-local-model": "node scripts/check-ai-seq-local-model-option.mjs",
    "check:ai-seq-bottom-spacing": "node scripts/check-ai-seq-bottom-spacing-contract.mjs",
    "phase0:check": "node scripts/novaflow-phase0-check.mjs",
    "check:seethrough": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repair-seethrough-env.ps1",
    "repair:seethrough": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repair-seethrough-env.ps1 -Repair",
    "diagnose:entry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnose-runtime-entry.ps1",
    "deploy:program-files": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-to-program-files.ps1",
    "deploy:program-files:confirm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-to-program-files.ps1 -ConfirmDeploy",
    "watch:auto-commit": "chokidar \"src/**/*\" \"renderer/**/*\" \"main/**/*\" \"public/**/*\" \"package.json\" \"package-lock.json\" \"vite.config.*\" \"electron.*\" -i \"**/node_modules/**\" -i \"**/dist/**\" -i \"**/build/**\" -i \"**/.git/**\" -i \"**/logs/**\" -i \"**/*.log\" -i \"**/.vite/**\" -i \"**/coverage/**\" -c \"npm run auto-commit\" --debounce 2500",
    "auto-commit": "node scripts/auto-commit.js",
    "prepare": "husky",
    "lint": "node -e \"console.log('lint: no project lint configured; placeholder passed')\""
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "husky": "^9.1.7"
  }
}
