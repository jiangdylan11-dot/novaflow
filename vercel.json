{
  "installCommand": "cd particle-editor && npm ci",
  "buildCommand": "cd particle-editor && npm run build",
  "outputDirectory": "particle-editor/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
